PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/bathroom-design

# Пароль входа в админку (/admin)
ADMIN_PASSWORD=
# Секрет для подписи JWT админа — длинная случайная строка
JWT_SECRET=
# Отдельный пароль-подтверждение для "Удалить всё из БД"
ADMIN_PURGE_PASSWORD=

# Визуальный поиск по фото. Основной провайдер — Gemini: на одном и том же
# снимке он распознал 7 предметов против 1 у Groq и верно назвал цвет и тип
# установки смесителя, где Groq ошибся и в том, и в другом. Groq остаётся
# резервом: если Gemini не ответил, запрос автоматически уходит к нему.
# Без обоих ключей функция отдаёт 503 и не ломает сайт.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# ВАЖНО для прода: Google отвечает 400 "User location is not supported" на
# запросы с IP нашего хостинга (AS39318, PS.KZ). Блокируется не страна —
# с домашнего интернета в Казахстане тот же ключ работает, — а диапазон
# дата-центра. Поэтому на сервере запросы идут через прокси-воркер
# (scripts/gemini-proxy-worker.js), а тут прописывается его адрес.
# Пусто = ходить напрямую в Google (так работает локальная разработка).
# GEMINI_BASE_URL=https://<имя>.<аккаунт>.workers.dev
# GEMINI_PROXY_SECRET=

GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
#
# Принудительно выбрать провайдера, если заданы оба ключа: groq | gemini
# VISUAL_SEARCH_PROVIDER=

# Куда складывать загруженные изображения (по умолчанию backend/uploads)
# UPLOADS_DIR=
# Лимит размера загружаемого видео категории, МБ
# VIDEO_UPLOAD_MAX_MB=100
