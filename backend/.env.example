PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/bathroom-design

# Пароль входа в админку (/admin)
ADMIN_PASSWORD=
# Секрет для подписи JWT админа — длинная случайная строка
JWT_SECRET=
# Отдельный пароль-подтверждение для "Удалить всё из БД"
ADMIN_PURGE_PASSWORD=

# Визуальный поиск по фото. Провайдер выбирается автоматически: если задан
# GROQ_API_KEY — используется Groq, иначе Gemini. Без обоих ключей функция
# отдаёт 503 и не ломает сайт.
#
# ВАЖНО: Google блокирует Gemini API для Казахстана — с прод-сервера он
# отвечает 400 "User location is not supported". На проде нужен именно Groq.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
#
# Gemini работает с локальной машины (обычный провайдер), для разработки удобен.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# Принудительно выбрать провайдера, если заданы оба ключа: groq | gemini
# VISUAL_SEARCH_PROVIDER=

# Куда складывать загруженные изображения (по умолчанию backend/uploads)
# UPLOADS_DIR=
# Лимит размера загружаемого видео категории, МБ
# VIDEO_UPLOAD_MAX_MB=100
